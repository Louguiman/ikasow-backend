# ============================================
# IKASOW Backend Environment Configuration
# ============================================
# Copy this file to .env and update values for your environment
# NEVER commit .env file to version control

# ============================================
# Application Configuration
# ============================================

# NODE_ENV - Application environment (development, production, test)
# Controls database synchronization, logging verbosity, and error details
# Default: development
NODE_ENV=development

# PORT - HTTP server port
# The port on which the application will listen for requests
# Default: 3000
PORT=3000

# ============================================
# Database Configuration (PostgreSQL)
# ============================================

# DATABASE_HOST - PostgreSQL server hostname or IP address
# Default: localhost
DATABASE_HOST=localhost

# DATABASE_PORT - PostgreSQL server port
# Default: 5432
DATABASE_PORT=5432

# DATABASE_USERNAME - PostgreSQL username for authentication
# Required: Yes
DATABASE_USERNAME=postgres

# DATABASE_PASSWORD - PostgreSQL password for authentication
# Required: Yes
# SECURITY: Keep this secret and use strong passwords in production
DATABASE_PASSWORD=postgres

# DATABASE_NAME - Name of the PostgreSQL database
# Required: Yes
DATABASE_NAME=immomali

# ============================================
# JWT Authentication Configuration
# ============================================

# JWT_SECRET - Secret key for signing JWT access tokens
# Required: Yes
# SECURITY: Use a strong, random string (minimum 32 characters) in production
# Generate with: openssl rand -base64 32
JWT_SECRET=your-secret-key-change-this-in-production

# JWT_EXPIRATION - Access token expiration time
# Format: number + unit (s=seconds, m=minutes, h=hours, d=days)
# Examples: 15m, 1h, 24h
# Default: 1h
JWT_EXPIRATION=1h

# REFRESH_TOKEN_SECRET - Secret key for signing JWT refresh tokens
# Required: Yes
# SECURITY: Use a different secret from JWT_SECRET
# Generate with: openssl rand -base64 32
REFRESH_TOKEN_SECRET=your-refresh-secret-key-change-this-in-production

# REFRESH_TOKEN_EXPIRATION - Refresh token expiration time
# Format: number + unit (s=seconds, m=minutes, h=hours, d=days)
# Default: 7d
REFRESH_TOKEN_EXPIRATION=7d

# ============================================
# File Upload Configuration
# ============================================

# UPLOAD_DIR - Directory path for storing uploaded files
# Path can be relative or absolute
# Default: ./uploads
UPLOAD_DIR=./uploads

# MAX_FILE_SIZE - Maximum file size in bytes
# Default: 5242880 (5MB)
# Examples: 1048576 (1MB), 10485760 (10MB)
MAX_FILE_SIZE=5242880

# ============================================
# CORS Configuration
# ============================================

# CORS_ORIGIN - Allowed origin(s) for Cross-Origin Resource Sharing
# Can be a single origin or comma-separated list
# Supports wildcard patterns for subdomains (e.g., *.ikasow.com)
# Use '*' to allow all origins (NOT recommended for production)
# Examples:
#   - Single origin: http://localhost:5173
#   - Multiple origins: http://localhost:5173,https://app.example.com
#   - Subdomain wildcard: https://*.ikasow.com,http://localhost:5173
# Default: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# CORS_METHODS - Allowed HTTP methods for CORS requests
# Comma-separated list of HTTP methods
# Default: GET,HEAD,PUT,PATCH,POST,DELETE
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE

# CORS_HEADERS - Allowed headers for CORS requests
# Comma-separated list of header names
# Default: Content-Type,Accept,Authorization
CORS_HEADERS=Content-Type,Accept,Authorization

# ============================================
# Logging Configuration
# ============================================

# LOG_LEVEL - Minimum log level to output
# Options (from least to most verbose):
#   - error: Only log errors
#   - warn: Log warnings and errors
#   - info: Log informational messages, warnings, and errors (recommended for production)
#   - http: Log HTTP requests plus all above
#   - verbose: Log detailed information plus all above
#   - debug: Log debug information plus all above (recommended for development)
#   - silly: Log everything (very verbose, use for troubleshooting only)
# Default: info
# Recommended: debug (development), info (production), error (production with high traffic)
LOG_LEVEL=info

# ============================================
# Redis Cache Configuration
# ============================================

# REDIS_HOST - Redis server hostname or IP address
# Default: localhost
REDIS_HOST=localhost

# REDIS_PORT - Redis server port
# Default: 6379
REDIS_PORT=6379

# REDIS_PASSWORD - Redis authentication password
# Optional: Leave empty if Redis has no password
# SECURITY: Use password protection in production
REDIS_PASSWORD=

# REDIS_DB - Redis database number (0-15)
# Default: 0
REDIS_DB=0

# ============================================
# Cache TTL Configuration (Time To Live in seconds)
# ============================================

# CACHE_TTL_PROPERTIES - Cache duration for property listings
# Default: 300 (5 minutes)
CACHE_TTL_PROPERTIES=300

# CACHE_TTL_AGENCY - Cache duration for agency data
# Default: 3600 (1 hour)
CACHE_TTL_AGENCY=3600
